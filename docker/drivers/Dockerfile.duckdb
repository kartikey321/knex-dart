FROM ghcr.io/cirruslabs/flutter:stable

ARG DUCKDB_VERSION=v1.4.4

WORKDIR /workspace
COPY . .
RUN flutter pub get

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl unzip \
    && rm -rf /var/lib/apt/lists/* \
    && ARCH=$(uname -m) \
    && case "$ARCH" in \
         x86_64)  DUCKDB_ARCH=amd64 ;; \
         aarch64) DUCKDB_ARCH=arm64 ;; \
         *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
       esac \
    && curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors "https://github.com/duckdb/duckdb/releases/download/${DUCKDB_VERSION}/libduckdb-linux-${DUCKDB_ARCH}.zip" -o /tmp/libduckdb.zip \
    && unzip -o /tmp/libduckdb.zip libduckdb.so -d /usr/local/lib/ \
    && ldconfig \
    && rm /tmp/libduckdb.zip

WORKDIR /workspace/drivers/knex_dart_duckdb
CMD ["dart", "test"]
